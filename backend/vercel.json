{
  "version": 2,
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/server.js",
      "methods": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"]
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "BUILD_VERSION": "1.0.3"
  },
  "functions": {
    "src/server.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "installCommand": "npm install",
  "buildCommand": "echo 'Build complete - v1.0.2'"
}
