# ==============================================
# PRODUCTION ENVIRONMENT VARIABLES
# Set these in your Vercel dashboard under Environment Variables
# ==============================================

# Production API Configuration
NEXT_PUBLIC_API_URL=https://merelosjeff-portfolio-backend.vercel.app
NEXT_PUBLIC_SITE_URL=https://merelosjeff-portfolio-frontend.vercel.app

# Admin Portal Configuration (secure route for production)
NEXT_PUBLIC_ADMIN_ROUTE_PREFIX=/admin-portal

# Site Information
NEXT_PUBLIC_SITE_NAME=Jeff Developer
NEXT_PUBLIC_GITHUB_USERNAME=jeffdev

# ==============================================
# DEPLOYMENT INSTRUCTIONS
# ==============================================
# 1. Go to Vercel Dashboard > Your Project > Settings > Environment Variables
# 2. Add each variable above with their production values
# 3. Deploy your application
# 
# The API client will automatically detect the production environment
# and use the appropriate backend URL.